rules_version = '2';

// Rules for the AppScale contact form.
// Anyone may CREATE a contact submission (public form), but nobody can
// read, update, or delete them from the client — you view submissions
// in the Firebase console. Paste these into Firestore → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /contacts/{docId} {
      allow create: if
        request.resource.data.keys().hasOnly(
          ['name', 'email', 'company', 'message', 'createdAt']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 200
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 5000
        && request.resource.data.company is string
        && request.resource.data.company.size() < 200;

      allow read, update, delete: if false;
    }
  }
}
